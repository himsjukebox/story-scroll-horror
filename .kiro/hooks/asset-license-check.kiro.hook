{
  "enabled": true,
  "name": "Asset license check",
  "description": "When a file is added under public/scenes, public/costumes, public/models, public/fonts or public/samples, check that it is listed in ASSETS.md with a source and licence, and that it has no copyrighted, trademarked or real film content.",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "public/scenes/**",
      "public/costumes/**",
      "public/models/**",
      "public/fonts/**",
      "public/samples/**"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new asset file was added. 1) Open ASSETS.md (create it from the template in .kiro/specs/story-scroll-horror/design.md if it is missing). 2) Check that the new file path has a row with: path, what it is, how it was made or where it came from (own work, AI tool and prompt, or source URL), and its licence. 3) If the row is missing, add it with placeholders marked TODO for facts you do not know, and tell me exactly what to fill in. Do not invent a source or licence. 4) Flag the file if the name or content suggests a third-party trademark, logo, real film or character name, or copyrighted music (requirement 17.4). 5) Fonts must be self-hosted files, never a link to Google Fonts. Keep the reply under 5 lines and use no em dashes."
  }
}
